<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>AP 세계사 Unit 3: 육상 제국 (1450–1750)</title>
    <dateCreated>Sat, 03 Oct 2026 14:30:00 PDT</dateCreated>
  </head>
  <body>
    <outline text="Unit 3: 육상 제국 (1450–1750)">

      <outline text="🌙 오스만 제국 (1300년대–1918) · 수니파">
        <outline text="인물">
          <outline text="오스만 (Osman) — 제국 건국자 (1300년대)"/>
          <outline text="메흐메트 2세 (Mehmed II, r. 1451–1481) — 대포로 콘스탄티노플 정복 [3.1]"/>
          <outline text="쉴레이만 1세 (Suleiman I, r. 1520–1566) — 제국 전성기, 로도스·헝가리 정복 [3.1]"/>
          <outline text="시난 (Sinan) — 쉴레이마니예 모스크 건축가 [3.2]"/>
        </outline>
        <outline text="사건">
          <outline text="1453 — 콘스탄티노플 정복 → 이스탄불 [3.1]"/>
          <outline text="1514 — 찰디란 전투, 사파비에 승리 [3.1, 3.3]"/>
          <outline text="1517 — 맘루크로부터 이집트 정복, 술탄이 칼리프 칭호 주장 [3.1, 3.2]"/>
          <outline text="1522 / 1526 — 로도스·헝가리 정복 [3.1]"/>
          <outline text="1529 — 1차 빈 포위 실패 [3.1]"/>
          <outline text="1550–1557 — 쉴레이마니예 모스크 건축 [3.2]"/>
          <outline text="1571 — 레판토 해전 패배 [3.1]"/>
          <outline text="1683 — 2차 빈 포위 실패 (쇠퇴의 전환점) [3.1]"/>
          <outline text="1821 — 그리스 독립 → &quot;유럽의 병자&quot; [3.1]"/>
        </outline>
        <outline text="제도">
          <outline text="Devshirme → 예니체리 [3.2]"/>
          <outline text="징세 청부 (Tax farming) [3.2]"/>
          <outline text="밀레트 제도 (Millet system) [3.4]"/>
          <outline text="하렘 정치 (쇠퇴 원인) [3.1]"/>
        </outline>
      </outline>

      <outline text="🕌 사파비 제국 (1501–1760) · 시아파">
        <outline text="인물">
          <outline text="이스마일 (Ismail) — 건국자, shah 선언, 시아파 국교화 [3.1, 3.3]"/>
          <outline text="샤 아바스 1세 (Shah Abbas I, r. 1588–1629) — 전성기, ghulam 군인, 유럽 무기, 이스파한 [3.1, 3.2]"/>
          <outline text="마흐무드 (Mahmud) — 샤를 자칭한 아프간 지도자 (1722) [3.1]"/>
        </outline>
        <outline text="사건">
          <outline text="1501 — 이스마일, shah 선언 [3.1]"/>
          <outline text="1514 — 찰디란 전투에서 오스만에 패배 [3.1, 3.3]"/>
          <outline text="1598 — 이스파한 천도 [3.2]"/>
          <outline text="오스만의 사파비 비단 교역 금수 조치 [3.1]"/>
          <outline text="1722 — 아프간 반란 [3.1]"/>
          <outline text="1760 — Zand 왕조로 교체 (교재 기준 연도) [3.1]"/>
        </outline>
        <outline text="제도">
          <outline text="Ghulams (노예 군인) [3.2]"/>
          <outline text="시아파 국교 [3.3]"/>
        </outline>
      </outline>

      <outline text="🐘 무굴 제국 (1520년대–1800년대) · 인도">
        <outline text="인물">
          <outline text="티무르 (Tamerlane) — 몽골·튀르크계 정복자, 수도 사마르칸트, 바부르의 조상 [3.1]"/>
          <outline text="바부르 (Babur) — 건국자, 티무르의 후손 [3.1]"/>
          <outline text="악바르 (Akbar, r. 1556–1605) — 전성기, mansabdar, 지즈야 폐지, 딘이 일라히 [3.1, 3.2, 3.3]"/>
          <outline text="샤 자한 (Shah Jahan) — 타지마할 건축 [3.2]"/>
          <outline text="아우랑제브 (Aurangzeb, r. 1658–1707) — 엄격한 수니 정책, 지즈야 부활, 쇠퇴 [3.1, 3.3]"/>
          <outline text="구루 나나크 (Guru Nanak, 1469–1539) — 시크교 창시자 [3.3]"/>
        </outline>
        <outline text="사건">
          <outline text="1300년대 후반 — 티무르의 델리 약탈 [3.1]"/>
          <outline text="1500년경 — 펀자브에서 시크교 시작 [3.3]"/>
          <outline text="1520년대 — 바부르의 북인도 정복 [3.1]"/>
          <outline text="1564 — 악바르, 지즈야 폐지 [3.3]"/>
          <outline text="1582 — 악바르, 딘이 일라히 장려 [3.3]"/>
          <outline text="1632–1653 — 타지마할 건축 [3.2]"/>
          <outline text="1675 — 시크교 구루 테그 바하두르 처형 [3.3]"/>
          <outline text="1679 — 아우랑제브, 지즈야 부활 [3.3]"/>
          <outline text="1699 — 시크교 칼사 창설 [3.3]"/>
          <outline text="1800년대 — 영국 지배 [3.1]"/>
        </outline>
        <outline text="제도">
          <outline text="Mansabdar [3.2]"/>
          <outline text="Zamindar [3.2]"/>
          <outline text="카스트 제도 [3.1]"/>
        </outline>
      </outline>

      <outline text="🐉 중국: 명 (1368–1644) → 청 (1644–1911)">
        <outline text="인물">
          <outline text="강희제 (Kangxi, r. 1661–1722) — 안정과 확장, 대만·몽골·티베트 [3.1]"/>
          <outline text="건륭제 (Qianlong, r. 1736–1796) — 최대 영토, 신장 편입, 영국 교역 요청 거절 [3.1]"/>
          <outline text="조지 3세 (영국) — 1793년 교역 확대 요청 [3.1]"/>
        </outline>
        <outline text="사건">
          <outline text="1368 — 명, 원을 몰아냄 [3.1]"/>
          <outline text="1440년대 — 황제가 몽골에 포로로 잡힘 → 만리장성 재건 [3.1]"/>
          <outline text="1644 — 만주족, 청 건국 [3.1]"/>
          <outline text="1712 — 강희제, 인두세 고정 [3.2]"/>
          <outline text="1793 — 영국 교역 요청 거절, 교역은 광저우로 제한 [3.1]"/>
          <outline text="1796–1804 — 백련교의 난 [3.1]"/>
        </outline>
        <outline text="제도">
          <outline text="과거제 [3.2]"/>
          <outline text="만주 팔기, 변발 [3.4]"/>
          <outline text="자금성 [3.2]"/>
        </outline>
      </outline>

      <outline text="🐻 러시아 · 동방정교">
        <outline text="인물">
          <outline text="이반 4세 (Ivan IV, r. 1547–1584) — 첫 차르, 카잔·아스트라한 정복 [3.1]"/>
          <outline text="스트로가노프 가문 — 코사크를 고용해 볼가강 장악 [3.1]"/>
          <outline text="표트르 대제 (Peter the Great, r. 1682–1725) — 서구화 [3.2]"/>
        </outline>
        <outline text="사건">
          <outline text="1547 — 이반 4세, 차르 칭호 사용 [3.1]"/>
          <outline text="1639 — 태평양 도달 [3.1]"/>
          <outline text="1703 — 상트페테르부르크 건설 [3.2]"/>
          <outline text="1722 — 관등표 제정 [3.2]"/>
          <outline text="1741 / 1814 — 알래스카·캘리포니아 교역 거점 [3.1]"/>
        </outline>
      </outline>

      <outline text="🏰 서유럽">
        <outline text="인물">
          <outline text="구텐베르크 — 인쇄술 [3.1, 3.3]"/>
          <outline text="페르난도 &amp; 이사벨 (스페인) — 신군주정 [3.1]"/>
          <outline text="마르틴 루터 — 95개조 반박문 [3.3]"/>
          <outline text="장 칼뱅 — 예정설 [3.3]"/>
          <outline text="헨리 8세 (영국) — 영국 국교회 [3.3]"/>
          <outline text="이그나티우스 데 로욜라 — 예수회 창립 [3.3]"/>
          <outline text="루이 14세 (프랑스) — 태양왕, 베르사유 [3.2]"/>
        </outline>
        <outline text="사건">
          <outline text="1453 — 백년전쟁 종결 [3.1]"/>
          <outline text="1517 — 종교개혁 시작 [3.3]"/>
          <outline text="1534 — 수장령 [3.3]"/>
          <outline text="1545–1563 — 트리엔트 공의회 [3.3]"/>
          <outline text="1555 — 아우크스부르크 화의 [3.3]"/>
          <outline text="1598 — 낭트 칙령 [3.3]"/>
          <outline text="1618–1648 — 30년 전쟁 → 베스트팔렌 조약 [3.3]"/>
          <outline text="1682 — 베르사유로 궁정 이전 [3.2]"/>
        </outline>
      </outline>

      <outline text="🌎 아메리카 (3.2에서만 다룸)">
        <outline text="Mexica (아즈텍) — 우이칠로포치틀리에게 인신공양, 공물 제도 [3.2]"/>
        <outline text="잉카 — 사파 잉카는 태양신 인티의 아들, mit'a 노동세 [3.2]"/>
      </outline>

    </outline>
  </body>
</opml>
