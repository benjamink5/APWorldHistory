<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>AP World History Unit 3: Land-Based Empires (1450–1750)</title>
    <dateCreated>Sat, 03 Oct 2026 14:30:00 PDT</dateCreated>
  </head>
  <body>
    <outline text="Unit 3: Land-Based Empires (1450–1750)">

      <outline text="🌙 Ottoman Empire (1300s–1918) · Sunni">
        <outline text="People">
          <outline text="Osman — founder of the empire (1300s)"/>
          <outline text="Mehmed II, the Conqueror (r. 1451–1481) — took Constantinople with cannons [3.1]"/>
          <outline text="Suleiman I, the Magnificent (r. 1520–1566) — peak of the empire; Rhodes, Hungary [3.1]"/>
          <outline text="Sinan — architect of the Süleymaniye Mosque [3.2]"/>
        </outline>
        <outline text="Events">
          <outline text="1453 — Conquest of Constantinople → Istanbul [3.1]"/>
          <outline text="1514 — Battle of Chaldiran: defeats the Safavids [3.1, 3.3]"/>
          <outline text="1517 — Takes Egypt from the Mamluks; sultan claims title of caliph [3.1, 3.2]"/>
          <outline text="1522 / 1526 — Conquers Rhodes and Hungary [3.1]"/>
          <outline text="1529 — First siege of Vienna fails [3.1]"/>
          <outline text="1550–1557 — Süleymaniye Mosque built [3.2]"/>
          <outline text="1571 — Defeat at the Battle of Lepanto [3.1]"/>
          <outline text="1683 — Second siege of Vienna fails (turning point) [3.1]"/>
          <outline text="1821 — Greek independence → &quot;Sick Man of Europe&quot; [3.1]"/>
        </outline>
        <outline text="Systems">
          <outline text="Devshirme → Janissaries [3.2]"/>
          <outline text="Tax farming [3.2]"/>
          <outline text="Millet system [3.4]"/>
          <outline text="Harem politics (decline) [3.1]"/>
        </outline>
      </outline>

      <outline text="🕌 Safavid Empire (1501–1760) · Shi'a">
        <outline text="People">
          <outline text="Ismail — founder; proclaimed shah, made Shi'a Islam the state religion [3.1, 3.3]"/>
          <outline text="Shah Abbas I (r. 1588–1629) — peak; ghulams, European weapons, Isfahan [3.1, 3.2]"/>
          <outline text="Mahmud — Afghan leader who declared himself shah (1722) [3.1]"/>
        </outline>
        <outline text="Events">
          <outline text="1501 — Ismail proclaimed shah [3.1]"/>
          <outline text="1514 — Defeated by the Ottomans at Chaldiran [3.1, 3.3]"/>
          <outline text="1598 — Isfahan becomes the capital [3.2]"/>
          <outline text="Ottoman embargo on Safavid silk trade [3.1]"/>
          <outline text="1722 — Afghan revolt [3.1]"/>
          <outline text="1760 — Replaced by the Zand Dynasty (textbook date) [3.1]"/>
        </outline>
        <outline text="Systems">
          <outline text="Ghulams (slave soldiers) [3.2]"/>
          <outline text="Shi'a state religion [3.3]"/>
        </outline>
      </outline>

      <outline text="🐘 Mughal Empire (1520s–1800s) · India">
        <outline text="People">
          <outline text="Tamerlane (Timur) — Mongol-Turkic conqueror, capital Samarkand; Babur's ancestor [3.1]"/>
          <outline text="Babur — founder; descendant of Timur [3.1]"/>
          <outline text="Akbar (r. 1556–1605) — peak; mansabdars, abolished jizya, Din-i Ilahi [3.1, 3.2, 3.3]"/>
          <outline text="Shah Jahan — built the Taj Mahal [3.2]"/>
          <outline text="Aurangzeb (r. 1658–1707) — strict Sunni policy, restored jizya; decline [3.1, 3.3]"/>
          <outline text="Guru Nanak (1469–1539) — founder of Sikhism [3.3]"/>
        </outline>
        <outline text="Events">
          <outline text="Late 1300s — Tamerlane sacks Delhi [3.1]"/>
          <outline text="c. 1500 — Sikhism begins in Punjab [3.3]"/>
          <outline text="1520s — Babur conquers northern India [3.1]"/>
          <outline text="1564 — Akbar abolishes the jizya [3.3]"/>
          <outline text="1582 — Akbar promotes Din-i Ilahi [3.3]"/>
          <outline text="1632–1653 — Taj Mahal built [3.2]"/>
          <outline text="1675 — Sikh guru Tegh Bahadur executed [3.3]"/>
          <outline text="1679 — Aurangzeb restores the jizya [3.3]"/>
          <outline text="1699 — Sikh Khalsa founded [3.3]"/>
          <outline text="1800s — British rule [3.1]"/>
        </outline>
        <outline text="Systems">
          <outline text="Mansabdars [3.2]"/>
          <outline text="Zamindars [3.2]"/>
          <outline text="Caste system [3.1]"/>
        </outline>
      </outline>

      <outline text="🐉 China: Ming (1368–1644) → Qing (1644–1911)">
        <outline text="People">
          <outline text="Kangxi (r. 1661–1722) — stability and expansion; Taiwan, Mongolia, Tibet [3.1]"/>
          <outline text="Qianlong (r. 1736–1796) — largest territory; Xinjiang; rejected British trade [3.1]"/>
          <outline text="George III (Britain) — sent the 1793 trade request [3.1]"/>
        </outline>
        <outline text="Events">
          <outline text="1368 — Ming overthrows the Yuan [3.1]"/>
          <outline text="1440s — Emperor captured by Mongols → Great Wall rebuilt [3.1]"/>
          <outline text="1644 — Manchus found the Qing [3.1]"/>
          <outline text="1712 — Kangxi freezes the head tax [3.2]"/>
          <outline text="1793 — British trade request rejected; trade stays at Canton [3.1]"/>
          <outline text="1796–1804 — White Lotus Rebellion [3.1]"/>
        </outline>
        <outline text="Systems">
          <outline text="Civil service exam [3.2]"/>
          <outline text="Manchu banners, queue [3.4]"/>
          <outline text="Forbidden City [3.2]"/>
        </outline>
      </outline>

      <outline text="🐻 Russia · Orthodox Christianity">
        <outline text="People">
          <outline text="Ivan IV, the Terrible (r. 1547–1584) — first tsar; conquered Kazan and Astrakhan [3.1]"/>
          <outline text="Stroganov family — hired Cossacks to control the Volga [3.1]"/>
          <outline text="Peter the Great (r. 1682–1725) — westernization [3.2]"/>
        </outline>
        <outline text="Events">
          <outline text="1547 — Ivan IV takes the title tsar [3.1]"/>
          <outline text="1639 — Russians reach the Pacific [3.1]"/>
          <outline text="1703 — St. Petersburg founded [3.2]"/>
          <outline text="1722 — Table of Ranks [3.2]"/>
          <outline text="1741 / 1814 — Trading posts in Alaska and California [3.1]"/>
        </outline>
      </outline>

      <outline text="🏰 Western Europe">
        <outline text="People">
          <outline text="Johannes Gutenberg — printing press [3.1, 3.3]"/>
          <outline text="Ferdinand &amp; Isabella (Spain) — new monarchy [3.1]"/>
          <outline text="Martin Luther — 95 Theses [3.3]"/>
          <outline text="John Calvin — predestination [3.3]"/>
          <outline text="Henry VIII (England) — Church of England [3.3]"/>
          <outline text="Ignatius of Loyola — founded the Jesuits [3.3]"/>
          <outline text="Louis XIV (France) — Sun King, Versailles [3.2]"/>
        </outline>
        <outline text="Events">
          <outline text="1453 — End of the Hundred Years' War [3.1]"/>
          <outline text="1517 — Protestant Reformation begins [3.3]"/>
          <outline text="1534 — Act of Supremacy [3.3]"/>
          <outline text="1545–1563 — Council of Trent [3.3]"/>
          <outline text="1555 — Peace of Augsburg [3.3]"/>
          <outline text="1598 — Edict of Nantes [3.3]"/>
          <outline text="1618–1648 — Thirty Years' War → Peace of Westphalia [3.3]"/>
          <outline text="1682 — Court moves to Versailles [3.2]"/>
        </outline>
      </outline>

      <outline text="🌎 Americas (3.2 only)">
        <outline text="Mexica (Aztec) — human sacrifice to Huitzilopochtli; tribute system [3.2]"/>
        <outline text="Inca — Sapa Inca as son of the sun god Inti; mit'a labor tax [3.2]"/>
      </outline>

    </outline>
  </body>
</opml>
