<?xml version="1.0" encoding="utf-8"?>
<opml version="2.0">
  <head>
    <title>AP World History Unit 4 Mindmap (English)</title>
  </head>
  <body>
    <outline text="Unit 4: Transoceanic Interconnections (c. 1450 to c. 1750)">
      <outline text="Portugal (Portuguese Maritime Empire)">
        <outline text="Figures">
          <outline text="Prince Henry the Navigator (1394–1460) — Financed navigational research at Sagres and sponsored West African coastal exploration [4.1, 4.2]"/>
          <outline text="Bartholomew Diaz (c. 1450–1500) — First European mariner to round the Cape of Good Hope in 1488 [4.2]"/>
          <outline text="Vasco da Gama (c. 1460–1524) — Reached Calicut, India in 1498, opening the direct maritime spice route [4.2, 4.4]"/>
          <outline text="Afonso de Albuquerque (1453–1515) — Seized Goa, Malacca, and Hormuz to establish the Portuguese spice monopoly [4.2]"/>
        </outline>
        <outline text="Events">
          <outline text="1415 — Portuguese conquest of Ceuta in North Africa [4.1]"/>
          <outline text="1488 — Bartholomew Diaz rounds the Cape of Good Hope [4.2]"/>
          <outline text="1494 — Treaty of Tordesillas divides Atlantic and New World spheres with Spain [4.4]"/>
          <outline text="1498 — Vasco da Gama reaches India and bombards Swahili city-states [4.2, 4.4]"/>
          <outline text="1507 — Fortress established at Hormuz on the Persian Gulf [4.2]"/>
          <outline text="1509 — Portuguese victory at the Battle of Diu secures Arabian Sea naval hegemony [4.2, 4.5]"/>
          <outline text="1510 — Portuguese establish administrative naval headquarters at Goa [4.2]"/>
          <outline text="1511 — Albuquerque conquers the strategic choke point of Malacca [4.2, 4.4]"/>
          <outline text="1514 — Portuguese merchants arrive in southern China [4.2]"/>
          <outline text="1549 — Portuguese merchants and Jesuit missionaries arrive in Japan [4.2, 4.4]"/>
        </outline>
        <outline text="Institutions &amp; Policies">
          <outline text="Trading Post Empire — Maritime choke point control over trade networks rather than expansive inland territorial rule [4.2, 4.4]"/>
          <outline text="Cartaz System — Mandatory naval customs passes required for non-Portuguese merchant vessels in the Indian Ocean [4.2]"/>
          <outline text="Engenhos — Complex Brazilian sugar mill and plantation enterprises fueled by enslaved African labor [4.3, 4.4]"/>
        </outline>
      </outline>
      <outline text="Spain (Spanish Global Empire)">
        <outline text="Figures">
          <outline text="Christopher Columbus (1451–1506) — Genoese mariner sponsored by Spain who crossed the Atlantic in 1492 [4.1, 4.2, 4.3]"/>
          <outline text="Ferdinand Magellan (c. 1480–1521) — Commanded the first global circumnavigation expedition (1519–1522) [4.2]"/>
          <outline text="Hernán Cortés (1485–1547) — Conquistador who overthrew the Aztec Empire in 1521 to establish New Spain [4.4]"/>
          <outline text="Francisco Pizarro (c. 1478–1541) — Conquistador who conquered the Inca Empire between 1532 and 1572 [4.4]"/>
          <outline text="Pedro Menéndez de Avilés (1519–1574) — Founded St. Augustine, Florida in 1565 [4.4]"/>
          <outline text="Bartolomé de Las Casas (1484–1566) — Dominican friar who condemned Spanish atrocities in A Short Account of the Destruction of the Indies [4.8]"/>
        </outline>
        <outline text="Events">
          <outline text="1492 — Reconquista completed; expulsion of Spanish Jews; Columbus crosses the Atlantic [4.2, 4.7]"/>
          <outline text="1494 — Treaty of Tordesillas establishes demarcation meridian with Portugal [4.4]"/>
          <outline text="1518 — First documented smallpox outbreak ravages Caribbean indigenous populations [4.3]"/>
          <outline text="1519–1522 — Magellan expedition circumnavigates the globe [4.2]"/>
          <outline text="1521 — Cortés completes the conquest of Tenochtitlán (Aztec Empire) [4.4]"/>
          <outline text="1532 — Pizarro captures Incan Emperor Atahualpa at Cajamarca [4.4]"/>
          <outline text="1545 — Discovery of massive subterranean silver deposits at Potosí [4.4, 4.5]"/>
          <outline text="1565 — Spain annexes the Philippines; founds St. Augustine in Florida [4.2, 4.4]"/>
          <outline text="1571 — Founding of Manila as trans-Pacific silver-silk entrepôt [4.2]"/>
          <outline text="1680 — Pueblo Revolt temporarily expels Spanish colonizers from New Mexico [4.6]"/>
        </outline>
        <outline text="Institutions &amp; Policies">
          <outline text="Viceroyalties &amp; Audiencias — Centralized colonial governance divided into New Spain and Peru, overseen by royal appellate courts [4.5]"/>
          <outline text="Casta System — Rigid socio-racial hierarchy separating Peninsulares, Criollos, Mestizos, Mulattoes, and subjugated laborers [4.7, 4.8]"/>
          <outline text="Encomienda &amp; Hacienda Systems — Royal labor grants evolving into private debt peonage agrarian estates [4.4]"/>
          <outline text="Colonial Mita — Coerced rotational draft compelling Andean indigenous males into Potosí silver mines [4.4]"/>
          <outline text="Manila Galleons — Annual armed trans-Pacific trade transporting American silver to Manila in exchange for Chinese luxuries [4.2, 4.5]"/>
        </outline>
      </outline>
      <outline text="The Netherlands (Dutch Republic)">
        <outline text="Figures">
          <outline text="Henry Hudson (c. 1565–1611) — English navigator sailed for the Dutch in 1609, exploring the Hudson River valley [4.2]"/>
          <outline text="Rembrandt van Rijn (1606–1669) — Dutch Golden Age painter whose works celebrated bourgeois mercantile prosperity [4.8]"/>
        </outline>
        <outline text="Events">
          <outline text="1602 — Chartering of the Dutch East India Company (VOC); opening of Amsterdam Stock Exchange [4.5]"/>
          <outline text="1609 — Establishment of the Bank of Amsterdam as international currency clearinghouse [4.5]"/>
          <outline text="1620 — VOC establishes fortified colonial administrative capital at Batavia (Java) [4.2]"/>
          <outline text="1624 — Dutch establish New Amsterdam on Manhattan Island [4.2]"/>
          <outline text="1641 — Dutch capture Malacca from Portugal and gain exclusive European trade rights at Deshima, Japan [4.2, 4.4]"/>
        </outline>
        <outline text="Institutions &amp; Policies">
          <outline text="Dutch East India Company (VOC) — First publicly traded joint-stock corporation with limited liability and quasi-governmental sovereign powers [4.5]"/>
          <outline text="Fluyt Ship Architecture — Low-cost, high-capacity commercial freight carrier requiring minimal crew [4.1, 4.5]"/>
          <outline text="Amsterdam Financial Exchange — Standardized public stock trading and deposit banking supporting global commercial dominance [4.5]"/>
        </outline>
      </outline>
      <outline text="Great Britain (England &amp; British Empire)">
        <outline text="Figures">
          <outline text="John Cabot (c. 1450–1499) — Italian-born explorer who claimed Newfoundland for the English crown in 1497 [4.2]"/>
          <outline text="James II (1633–1701) — Catholic absolutist monarch deposed during the Glorious Revolution of 1688 [4.6]"/>
          <outline text="William III of Orange &amp; Mary II (r. 1689–1702) — Protestant joint monarchs who accepted the English Bill of Rights [4.6]"/>
          <outline text="Queen Nanny (c. 1686–1755) — Windward Maroon leader in Jamaica who fought British forces to secure maroon autonomy treaties [4.6]"/>
        </outline>
        <outline text="Events">
          <outline text="1497 — John Cabot explores the North American Atlantic coast [4.2]"/>
          <outline text="1600 — Chartering of the British East India Company (EIC) [4.5]"/>
          <outline text="1607 — Founding of Jamestown, Virginia, the first permanent English colony in North America [4.2]"/>
          <outline text="1663 — Gloucester County conspiracy unites enslaved Africans and indentured servants [4.6]"/>
          <outline text="1675–1678 — Metacom's War (King Philip's War) shatters native resistance in New England [4.6]"/>
          <outline text="1688–1689 — Glorious Revolution establishes parliamentary supremacy and the English Bill of Rights [4.6]"/>
          <outline text="1720 — South Sea Bubble collapses, causing major financial panic [4.5]"/>
          <outline text="1728–1740 — First Jamaican Maroon War concludes with British recognition of maroon self-governance [4.6]"/>
          <outline text="1756–1763 — Seven Years' War results in British expulsion of France from India and Canada [4.4]"/>
        </outline>
        <outline text="Institutions &amp; Policies">
          <outline text="British East India Company (EIC) — Joint-stock corporate entity that utilized sepoy mercenaries to conquer India [4.4, 4.5]"/>
          <outline text="Indentured Servitude — Contractual labor system supplying European agrarian labor to colonial tobacco plantations [4.4]"/>
          <outline text="Parliamentary Constitutionalism — Legal structure binding royal power beneath legislative statute following 1689 [4.6]"/>
        </outline>
      </outline>
      <outline text="France (Kingdom of France)">
        <outline text="Figures">
          <outline text="Jacques Cartier (1491–1557) — Explored the St. Lawrence River valley in 1535 claiming territory for France [4.2]"/>
          <outline text="Samuel de Champlain (1567–1635) — Cartographer and explorer who founded Quebec in 1608 [4.2]"/>
          <outline text="Louis XIV (1638–1715) — The 'Sun King' who epitomized royal absolutism ('L'état, c'est moi') at Versailles [4.7]"/>
        </outline>
        <outline text="Events">
          <outline text="1535 — Jacques Cartier navigates the St. Lawrence River [4.2]"/>
          <outline text="1608 — Founding of Quebec establishes the colonial capital of New France [4.2]"/>
          <outline text="1648–1653 — The Fronde civil uprisings attempt to curtail French royal absolutism [4.6]"/>
          <outline text="1701 — Great Peace of Montreal resolves decades of war between New France and the Iroquois [4.4]"/>
          <outline text="1720 — Collapse of John Law's Mississippi Company bubble destabilizes French royal finances [4.5]"/>
          <outline text="1763 — Treaty of Paris forces France to cede Canada and Indian enclaves to Britain [4.4]"/>
        </outline>
        <outline text="Institutions &amp; Policies">
          <outline text="New France Fur Trade Network — Commercial-diplomatic partnerships with Huron and Algonquin tribes centered on beaver pelt export [4.2]"/>
          <outline text="Royal Absolutism at Versailles — Centralized administrative model subordinating the aristocracy through court rituals [4.7]"/>
        </outline>
      </outline>
      <outline text="Tsarist Russia (Russian Empire)">
        <outline text="Figures">
          <outline text="Ivan IV 'the Terrible' (1530–1584) — First crowned Tsar who crushed the noble boyar class to centralize autocracy [4.7]"/>
          <outline text="Peter I 'the Great' (1672–1725) — Westernizing Tsar who expanded Russian territory to the Baltic Sea [4.1, 4.7]"/>
          <outline text="Catherine II 'the Great' (1729–1796) — Autocratic empress who suppressed the Pugachev Rebellion and reinforced serfdom [4.6]"/>
          <outline text="Yemelyan Pugachev (1742–1775) — Cossack leader who led the massive peasant uprising of 1774 [4.6]"/>
        </outline>
        <outline text="Events">
          <outline text="1649 — Promulgation of the Law Code of 1649 legally entrenching hereditary serfdom [4.6, 4.7]"/>
          <outline text="1697 — Peter the Great's Grand Embassy visits Western Europe to study maritime technology [4.1]"/>
          <outline text="1774 — Outbreak of the Pugachev Rebellion between the Volga River and the Urals [4.6]"/>
        </outline>
        <outline text="Institutions &amp; Policies">
          <outline text="Russian Serfdom — Legal institution tying agricultural laborers permanently to land estates as unfree chattel [4.6, 4.7]"/>
          <outline text="Mirs — Autonomous rural village communes collectively managing land distribution and tax quotas [4.6]"/>
          <outline text="Cossack Cavalry Host — Semi-autonomous militarized frontiersmen utilized as shock troops for Siberian conquest [4.6]"/>
        </outline>
      </outline>
      <outline text="Gunpowder Empires &amp; Asian States">
        <outline text="Ottoman Empire">
          <outline text="Figures: Sultan Mehmed II (1432–1481) — Conquered Constantinople (1453) and welcomed exiled Spanish Jews (1492) [4.1, 4.7]"/>
          <outline text="Figures: Sultan Suleiman the Magnificent (1494–1566) — Expanded Ottoman military power and married Roxelana [4.7]"/>
          <outline text="Figures: Roxelana / Hurrem Sultan (c. 1502–1558) — Former enslaved captive who rose to empress, initiating 'Harem Politics' [4.7]"/>
          <outline text="Events: 1453 — Fall of Constantinople stimulates European maritime exploration [4.1]"/>
          <outline text="Events: 1492 — Ottoman welcoming of Sephardic Jews following Spanish expulsion [4.7]"/>
          <outline text="Events: 1509 — Defeat of combined Ottoman-Egyptian-Venetian fleet at the Battle of Diu [4.2]"/>
          <outline text="Institutions: Timar System — Land and revenue grants given to cavalry warriors to maintain elite loyalty [4.7]"/>
          <outline text="Institutions: Dhimmi &amp; Jizya — Protected status for religious minorities paying special taxes while maintaining communal autonomy [4.7]"/>
        </outline>
        <outline text="Mughal Empire (South Asia)">
          <outline text="Figures: Akbar the Great (1542–1605) — Expanded Mughal rule and instituted broad religious toleration [4.7]"/>
          <outline text="Figures: Aurangzeb (1618–1707) — Reimposed religious orthodoxy and jizya, provoking Maratha rebellion [4.6]"/>
          <outline text="Figures: Shivaji (1627–1680) — Hindu warrior leader who founded the independent Maratha Empire [4.6]"/>
          <outline text="Events: 1526 — Babur establishes the Mughal Empire in northern India [4.1]"/>
          <outline text="Events: 1680–1707 — Prolonged Mughal-Maratha Wars shatter Mughal central treasury and authority [4.6]"/>
          <outline text="Institutions: Zamindars &amp; Religious Accommodation — Elite tax collectors and interfaith royal governance under Akbar [4.7]"/>
        </outline>
        <outline text="Qing Dynasty (China)">
          <outline text="Figures: Li Chengdong &amp; Liu Liangzuo — Defector Han generals who conducted the Jaiding and Jiangyin massacres [4.7]"/>
          <outline text="Events: 1644 — Manchu conquest of Beijing and establishment of the Qing Dynasty [4.7]"/>
          <outline text="Events: 1645 — Imperial edict mandating the queue hairstyle for all Han men [4.7]"/>
          <outline text="Institutions: Queue Order — Mandatory shaved forehead and braided pigtail enforced under penalty of death [4.7]"/>
          <outline text="Institutions: Silver Fiscalization (Single Whip Law) — Tax system requiring silver bullion, drawing world silver into China [4.5, 4.8]"/>
        </outline>
        <outline text="Tokugawa Japan">
          <outline text="Figures: Toyotomi Hideyoshi (1537–1598) — Issued 1587 edict banning Christian missionaries [4.4]"/>
          <outline text="Figures: Tokugawa Ieyasu (1543–1616) — Founded the Tokugawa Shogunate in 1600 [4.1, 4.4]"/>
          <outline text="Events: 1549 — Francis Xavier introduces Jesuit Catholic missions to Japan [4.2]"/>
          <outline text="Events: 1600 — Battle of Sekigahara establishes Tokugawa hegemony [4.1]"/>
          <outline text="Events: 1630s — Enactment of Sakoku decrees enforcing national seclusion [4.4]"/>
          <outline text="Institutions: Sakoku (Closed Country Policy) — Absolute ban on foreign contact, travel abroad, and Christian worship [4.4]"/>
          <outline text="Institutions: Deshima Entrepôt — Artificial island in Nagasaki harbor strictly confining Dutch VOC trade [4.4]"/>
        </outline>
      </outline>
      <outline text="African States &amp; Atlantic Diaspora">
        <outline text="Figures">
          <outline text="Queen Ana Nzinga (1583–1663) — Monarch of Ndongo and Matamba who led multi-decade resistance against Portugal [4.6]"/>
        </outline>
        <outline text="Events">
          <outline text="1498 — Vasco da Gama's fleet sacks Swahili coastal trading city-states (Kilwa, Mombasa) [4.4]"/>
          <outline text="1591 — Moroccan firearm-equipped invasion destroys the Songhai Empire at Battle of Tondibi [4.5]"/>
          <outline text="1624 — Ana Nzinga becomes ruler of Ndongo, inaugurating resistance against Portuguese slave raids [4.6]"/>
        </outline>
        <outline text="Institutions &amp; Social Realities">
          <outline text="Gun-Slave Cycle — Process whereby West African states (Dahomey, Oyo, Asante) traded captives for European firearms [4.4, 4.5]"/>
          <outline text="Gender Imbalances &amp; Polygyny — Demographic distortion from male slave export leading to increased polygyny and female labor [4.5, 4.8]"/>
          <outline text="African Diaspora &amp; Syncretic Culture — Formation of creole languages (Gullah), musical traditions (banjo, spirituals), and syncretic faiths (Santería, Vodou) [4.3, 4.8]"/>
        </outline>
      </outline>
    </outline>
  </body>
</opml>
