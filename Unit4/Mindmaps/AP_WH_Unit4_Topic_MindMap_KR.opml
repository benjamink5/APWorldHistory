<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>AP World History Unit 4 토픽별 마인드맵</title>
  </head>
  <body>
    <outline text="Unit 4 대양 횡단 연결 (1450–1750)">
      <outline text="4.1 기술 혁신 (Technological Innovations)">
        <outline text="문화 간 기술 전파 (Diffusion)">
          <outline text="중국 나침반 (Compass)"/>
          <outline text="이슬람 아스트롤라베 (Astrolabe)"/>
          <outline text="삼각돛 (Lateen sail)"/>
          <outline text="천문도 (Astronomical charts)"/>
        </outline>
        <outline text="선박 설계 (Ship design)">
          <outline text="카라벨 (Caravel) — 탐험용"/>
          <outline text="캐럭 (Carrack) — 무장 화물선"/>
          <outline text="플루이트 (Fluyt) — 저비용 상선"/>
        </outline>
        <outline text="바람과 해류 이해 (Wind and current patterns)"/>
      </outline>
      <outline text="4.2 탐험의 원인과 전개 (Exploration)">
        <outline text="동기: God, Gold, Glory">
          <outline text="중상주의 (Mercantilism)"/>
          <outline text="국가 후원 (State sponsorship)"/>
        </outline>
        <outline text="포르투갈 (Portugal)">
          <outline text="디아스 (Bartolomeu Dias) — 1488 희망봉"/>
          <outline text="다 가마 (Vasco da Gama) — 1498 인도"/>
          <outline text="무역 거점 제국 (Trading-post empire)"/>
        </outline>
        <outline text="스페인 (Spain)">
          <outline text="콜럼버스 (Columbus) — 1492"/>
          <outline text="마젤란 (Magellan) — 1519–1522 세계 일주"/>
          <outline text="마닐라 갈레온 (Manila Galleons)"/>
        </outline>
        <outline text="영국·프랑스·네덜란드">
          <outline text="북서항로 (Northwest Passage)"/>
          <outline text="제임스타운·퀘벡·뉴암스테르담"/>
        </outline>
      </outline>
      <outline text="4.3 콜럼버스 교환 (Columbian Exchange)">
        <outline text="질병 (Disease)">
          <outline text="천연두 (Smallpox)"/>
          <outline text="원주민 50–90% 감소 (Great Dying)"/>
        </outline>
        <outline text="신대륙 → 구대륙">
          <outline text="감자·옥수수·마니옥"/>
          <outline text="구대륙 인구 증가"/>
        </outline>
        <outline text="구대륙 → 신대륙">
          <outline text="말·소·돼지"/>
          <outline text="사탕수수 (Sugarcane)"/>
          <outline text="벌채와 토양 침식"/>
        </outline>
        <outline text="플랜테이션 (Plantations)">
          <outline text="엔젠호 (Engenhos)"/>
          <outline text="아프리카 디아스포라 (African Diaspora)"/>
        </outline>
      </outline>
      <outline text="4.4 해양 제국 수립 (Maritime Empires Established)">
        <outline text="토르데시야스 조약 (Treaty of Tordesillas) — 1494"/>
        <outline text="정복자 (Conquistadors)">
          <outline text="코르테스 (Cortés) — 아스테카 1521"/>
          <outline text="피사로 (Pizarro) — 잉카 1532"/>
        </outline>
        <outline text="아시아의 제한 정책">
          <outline text="명 해금령 (Haijin)"/>
          <outline text="도쿠가와 쇄국 (Sakoku)"/>
        </outline>
        <outline text="아프리카 국가 성장">
          <outline text="아샨티 (Asante)"/>
          <outline text="콩고 (Kongo)"/>
        </outline>
        <outline text="강제 노동 (Coerced labor)">
          <outline text="동산 노예제 (Chattel slavery)"/>
          <outline text="계약 하인제 (Indentured servitude)"/>
          <outline text="엔코미엔다 &amp; 하시엔다 (Encomienda &amp; Hacienda)"/>
          <outline text="미타 (Mita) — 포토시 은광"/>
        </outline>
        <outline text="인도양 무역 지속 (Continuity)"/>
      </outline>
      <outline text="4.5 해양 제국 유지와 발전 (Maritime Empires Developed)">
        <outline text="경제 전략">
          <outline text="합자회사 (Joint-stock companies)"/>
          <outline text="VOC 1602 &amp; EIC 1600"/>
        </outline>
        <outline text="은 순환 (Silver flow)">
          <outline text="포토시 → 유럽 &amp; 마닐라"/>
          <outline text="중국 은 수요 (Single Whip)"/>
        </outline>
        <outline text="삼각무역 (Triangular trade)">
          <outline text="중간 항로 (Middle Passage)"/>
        </outline>
        <outline text="무역 경쟁">
          <outline text="디우 해전 (Battle of Diu) — 1509"/>
          <outline text="톤디비 전투 (Battle of Tondibi) — 1591"/>
        </outline>
        <outline text="사회와 문화">
          <outline text="카스타 제도 (Casta system)"/>
          <outline text="일부다처제 증가 (Polygyny)"/>
          <outline text="혼합 종교 (Syncretism)"/>
        </outline>
      </outline>
      <outline text="4.6 국가 권력에 대한 도전 (Challenges to State Power)">
        <outline text="국내 도전 (Internal)">
          <outline text="프롱드의 난 (Fronde)"/>
          <outline text="푸가초프 반란 (Pugachev)"/>
          <outline text="마라타 (Maratha) 대 무굴"/>
          <outline text="명예혁명 (Glorious Revolution) — 1688"/>
        </outline>
        <outline text="식민지 저항 (External)">
          <outline text="아나 은징가 (Ana Nzinga)"/>
          <outline text="푸에블로 반란 (Pueblo Revolt) — 1680"/>
          <outline text="메타콤 전쟁 (Metacom's War)"/>
        </outline>
        <outline text="노예 저항">
          <outline text="마룬 (Maroons)"/>
          <outline text="내니 여왕 (Queen Nanny)"/>
        </outline>
      </outline>
      <outline text="4.7 사회 위계의 변화 (Changing Social Hierarchies)">
        <outline text="소수 집단 정책">
          <outline text="스페인 유대인 추방 — 1492"/>
          <outline text="오스만 유대인 수용"/>
          <outline text="악바르 (Akbar) 지즈야 폐지"/>
        </outline>
        <outline text="청 변발령 (Queue)"/>
        <outline text="오스만 하렘 정치 — 록셀라나 (Roxelana)"/>
        <outline text="엘리트 변화">
          <outline text="부르주아지 부상 (Bourgeoisie)"/>
          <outline text="보야르 약화 (Boyars)"/>
          <outline text="유럽 귀족 약화 (Nobility)"/>
        </outline>
      </outline>
      <outline text="4.8 지속성과 변화 (Continuity and Change)">
        <outline text="변화 (Change)">
          <outline text="동서반구 통합"/>
          <outline text="은의 세계 화폐화"/>
          <outline text="강제 노동 확대"/>
          <outline text="인종 기반 위계"/>
        </outline>
        <outline text="지속 (Continuity)">
          <outline text="아시아 제조업 우위"/>
          <outline text="유라시아 농노제"/>
          <outline text="농업 중심 경제"/>
        </outline>
      </outline>
    </outline>
  </body>
</opml>
