      </outline>
    </outline>
    <outline text="Egypt and the Ottoman Empire">
      <outline text="People">
        <outline text="Muhammad Ali (r. 1805–1848) — State factories, European-model army, first Islamic-world newspaper [5.6]"/>
        <outline text="Mahmud II (r. 1808–1839) — Abolished the Janissaries; centralized taxes [5.8]"/>
        <outline text='Abdulhamid II (r. 1876–1909) — Accepted a constitution, then exiled the Young Turks; "Red Sultan" [5.8]'/>
      </outline>
      <outline text="Events">
        <outline text="1683 — Failed Ottoman attack on Vienna [5.2]"/>
        <outline text="1700s — Egypt exports carpets, silks, textiles to Europe [5.4]"/>
