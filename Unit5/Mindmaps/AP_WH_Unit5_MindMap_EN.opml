      </outline>
      <outline text="Institutions">
        <outline text="Prussian-model army and conscription [5.6]"/>
        <outline text="Prussian-style constitutional monarchy [5.6]"/>
        <outline text="High agricultural tax [5.6]"/>
        <outline text="Genro (elder statesmen) [5.8]"/>
        <outline text="Zaibatsu [5.6]"/>
