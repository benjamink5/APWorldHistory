        <outline text="1871 — Meiji letter to Ulysses Grant [5.6]"/>
        <outline text="1871 — Samurai class dissolved [5.8]"/>
        <outline text="1870s — Last samurai resistance (Satsuma, Choshu) [5.8]"/>
