        <outline text="Karl Benz (1844–1929) — Gasoline automobile [5.5 CED]"/>
        <outline text="Guglielmo Marconi (1874–1937) — Transatlantic radio signal (1901) [5.5]"/>
      </outline>
      <outline text="Events">
        <outline text="1834 — Zollverein customs union [5.4 CED]"/>
        <outline text="1848 — The Communist Manifesto [5.8, 5.10]"/>
