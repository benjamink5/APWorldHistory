        <outline text="1861 — Kingdom of Italy proclaimed [5.2 CED]"/>
        <outline text="1864 — War against Denmark [5.2]"/>
        <outline text="1866 — Seven Weeks' War with Austria [5.2]"/>
        <outline text="1870 — Franco-Prussian War [5.2]"/>
        <outline text="1871 — German Empire founded, incl. Alsace-Lorraine; rapid rise in steel and coal [5.2, 5.4]"/>
