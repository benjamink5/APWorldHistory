        <outline text="1886 — Benz automobile [5.5 CED]"/>
        <outline text="1901 — Marconi's transatlantic radio signal [5.5]"/>
      </outline>
      <outline text="Institutions">
        <outline text="Red Shirts [5.2]"/>
        <outline text="Plebiscites [5.2]"/>
