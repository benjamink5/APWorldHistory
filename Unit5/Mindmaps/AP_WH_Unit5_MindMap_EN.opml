    <outline text="Italy and German States">
      <outline text="People">
        <outline text="Giuseppe Mazzini (1805–1872) — Risorgimento [5.2]"/>
        <outline text="Camillo di Cavour (1810–1861) — PM of Piedmont-Sardinia; realpolitik [5.2]"/>
        <outline text="Giuseppe Garibaldi (1807–1882) — Red Shirts in southern Italy [5.2]"/>
        <outline text="Otto von Bismarck (1815–1898) — Unified Germany; accident, unemployment, old-age insurance [5.2, 5.10]"/>
