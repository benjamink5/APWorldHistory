        <outline text="1856 — Hatt-i Humayun [5.8]"/>
        <outline text="1869 — Suez Canal opens [5.5 CED]"/>
        <outline text="1870s–1880s — Ottomanism [5.2]"/>
        <outline text="1876 — Abdulhamid accepts a constitution [5.8]"/>
        <outline text="1882 — British occupation of Egypt [5.6 CED]"/>
        <outline text="1894–1896 — Hamidian massacres of Armenians [5.8]"/>
      </outline>
      <outline text="Institutions">
        <outline text="Ottomanism [5.2]"/>
        <outline text="Millets [5.8]"/>
        <outline text="Secular schools replacing the ulama [5.8]"/>
        <outline text="Mamluk military class [5.6]"/>
        <outline text="State-controlled cotton exports [5.6]"/>
