    <outline text="Haiti">
      <outline text="People">
        <outline text="Toussaint L'Ouverture (1743–1803) — Led the Haitian Revolution; 1801 constitution [5.2]"/>
        <outline text="Jean-Jacques Dessalines (1758–1806) — Declared independence 1804 [5.2]"/>
      </outline>
      <outline text="Events">
        <outline text="1791 — Slave revolt begins [5.2]"/>
        <outline text="1801 — Toussaint's constitution and land reform [5.2]"/>
        <outline text="1803 — Toussaint dies in a French prison [5.2]"/>
        <outline text="1804 — Independence: first black-led country in the Western Hemisphere [5.2]"/>
      </outline>
      <outline text="Institutions">
        <outline text="Plantation slavery (overthrown) [5.2]"/>
        <outline text="Maroons [5.2]"/>
      </outline>
    </outline>
    <outline text="Latin America">
      <outline text="People">
        <outline text="Simón Bolívar (1783–1830) — Freed Venezuela, Colombia, Ecuador, Peru; Gran Colombia; Jamaica Letter [5.1, 5.2]"/>
        <outline text='Manuela Sáenz (1797–1856) — Colonel; "Liberator of the Liberator" [5.2]'/>
        <outline text="Lola Rodríguez de Tió (1843–1924) — Puerto Rican poet; lyrics of La Borinqueña [5.2]"/>
        <outline text="José de San Martín (1778–1850) — Liberated Argentina and Chile [5.2 CED]"/>
        <outline text="Miguel Hidalgo (1753–1811) — Began Mexican independence revolt [5.2 CED]"/>
        <outline text="Pedro I (1798–1834; emperor 1822–1831) — Declared Brazil's independence [5.2 CED]"/>
      </outline>
      <outline text="Events">
        <outline text="1808 — Napoleon invades Spain [5.2]"/>
        <outline text="1810 — Hidalgo's revolt in Mexico [5.2 CED]"/>
        <outline text="1815 — Jamaica Letter [5.1, 5.2]"/>
        <outline text="1821 — Mexican independence [5.2 CED]"/>
        <outline text="1822 — Sáenz fights near Quito (Brazilian independence: CED) [5.2]"/>
        <outline text="1853 — Argentine constitution encourages immigration [5.2]"/>
        <outline text="1860 — Peru ends Spanish-literacy voting rule [5.2]"/>
        <outline text="1868 — Uprisings in Puerto Rico and Cuba [5.2]"/>
        <outline text="1888 — Brazil abolishes slavery [5.1, 5.10 CED]"/>
      </outline>
      <outline text="Institutions">
        <outline text="Peninsulares, creoles, mestizos, mulattoes hierarchy [5.2]"/>
