        <outline text="1805 — Muhammad Ali becomes governor [5.6]"/>
        <outline text="1826 — Janissaries abolished [5.8]"/>
        <outline text="1831 — Feudal system abolished [5.8]"/>
        <outline text="1839–1876 — Tanzimat reforms [5.6 CED, 5.8]"/>
        <outline text="1850, 1858 — Commercial and penal codes [5.8]"/>
