    </outline>
    <outline text="Russia">
      <outline text="People">
        <outline text="Alexander II (r. 1855–1881) — Emancipated the serfs [5.1]"/>
        <outline text="Sergei Witte (1849–1915) — State-led industrialization; Trans-Siberian Railway [5.4 CED, 5.6 CED]"/>
      </outline>
      <outline text="Events">
        <outline text="1853–1856 — Crimean War defeat [5.6 CED]"/>
        <outline text="1861 — Emancipation of 23 million serfs [5.1]"/>
        <outline text="1891 — Trans-Siberian Railroad begun (Moscow to the Pacific) [5.4]"/>
        <outline text="1900 — 36,000+ miles of railroad; 4th-largest steel producer [5.4]"/>
        <outline text="1917 — Communists take power; economy still mostly agricultural [5.4]"/>
      </outline>
      <outline text="Institutions">
        <outline text="Autocracy (continuity) [5.10 CED]"/>
      </outline>
    </outline>
    <outline text="Japan">
      <outline text="People">
        <outline text="Matthew Perry (1794–1858) — Forced Japan to open ports [5.6]"/>
        <outline text="Emperor Meiji (r. 1867–1912) — Selective Westernization; letter to Grant 1871 [5.6]"/>
      </outline>
      <outline text="Events">
        <outline text="1600–1854 — Near isolation from the world [5.6]"/>
        <outline text="1853–1854 — Perry's arrival and forced opening [5.6]"/>
