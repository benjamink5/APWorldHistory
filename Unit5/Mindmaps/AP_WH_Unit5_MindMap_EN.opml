<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>Unit 5: Revolutions (c. 1750–c. 1900)</title>
  </head>
  <body>
  <outline text="Unit 5: Revolutions (c. 1750–c. 1900)">
    <outline text="Britain">
      <outline text="People">
        <outline text="Edmund Burke (1729–1797) — Conservative critic of revolution [5.2]"/>
        <outline text="Francis Bacon (1561–1626) — Empiricism [5.1]"/>
        <outline text="Thomas Hobbes (1588–1679) — Leviathan; strong ruler via social contract [5.1]"/>
        <outline text="John Locke (1632–1704) — Natural rights; right to revolt; tabula rasa [5.1]"/>
        <outline text="Adam Smith (1723–1790) — The Wealth of Nations; laissez-faire [5.1, 5.7]"/>
        <outline text="Mary Wollstonecraft (1759–1797) — A Vindication of the Rights of Woman [5.1]"/>
        <outline text="James Hargreaves (c. 1720–1778) — Spinning jenny [5.3]"/>
        <outline text="Richard Arkwright (1732–1792) — Water frame; father of the factory system [5.3]"/>
        <outline text="James Watt (1736–1819) — Steam engine harnessing coal power [5.5]"/>
        <outline text="Henry Cort (1740–1800) — Wrought-iron process [5.5]"/>
        <outline text="George Stephenson (1781–1848) — Steam locomotive Rocket [5.5 CED]"/>
        <outline text="Henry Bessemer (1813–1898) — Bessemer Process for mass-produced steel [5.5]"/>
        <outline text="Robert Owen (1771–1858) — Utopian socialist; New Lanark and New Harmony [5.1, 5.8]"/>
        <outline text="John Stuart Mill (1806–1873) — Utilitarianism; legal unions, child-labor limits, safe factories [5.8]"/>
        <outline text="Cecil Rhodes (1853–1902) — Founded De Beers; Cape-to-Cairo railroad plan [5.7]"/>
        <outline text="Charles Dickens (1812–1870) — Oliver Twist (1839): middle class vs. urban poor [5.9]"/>
      </outline>
      <outline text="Events">
        <outline text="1574 — Elizabeth I acts against serfdom [5.1]"/>
        <outline text="early 1700s — Agricultural revolution: crop rotation, seed drill [5.3]"/>
        <outline text="c. 1750 — Industrial Revolution begins [5.3]"/>
        <outline text="1760s — Spinning jenny [5.3]"/>
        <outline text="1765 — Watt's steam engine [5.5]"/>
        <outline text="1769 — Arkwright patents the water frame [5.3]"/>
        <outline text="1794 — Cort patents wrought-iron process [5.5]"/>
        <outline text="1807 — Slave trade banned [5.1]"/>
        <outline text="1811–1816 — Luddite machine-breaking [5.8 CED]"/>
        <outline text="1827 — British, French, Russian fleet destroys Ottoman fleet [5.2]"/>
        <outline text="1830 — Liverpool–Manchester Railway opens [5.5 CED]"/>
        <outline text="1832, 1867, 1884 — Reform Bills widen male suffrage [5.1, 5.8]"/>
        <outline text="1833 — Sadler Report; Factory Act; slavery abolished in the empire [5.1 CED, 5.8]"/>
        <outline text="1840 — Britain annexes New Zealand [5.2]"/>
        <outline text="1840s — Women banned from coal mines [5.9]"/>
        <outline text="1843 — Children under 10 banned from coal mines [5.8]"/>
        <outline text="1846 — Repeal of the Corn Laws [5.7 CED]"/>
        <outline text="1847 — Ten Hours Act [5.8 CED]"/>
        <outline text="second half of 1800s — Public health acts, music halls, public parks [5.7, 5.9]"/>
        <outline text="1856 — Bessemer process [5.5]"/>
        <outline text="1881 — Schooling mandatory for ages 5–10 [5.8]"/>
        <outline text="1882 — First public power station opens in London [5.5]"/>
        <outline text="1882 — Britain occupies Egypt [5.6 CED]"/>
        <outline text="1918 — Vote for all men [5.8]"/>
        <outline text="1928 — Women win equal voting rights [5.1, 5.8]"/>
      </outline>
      <outline text="Institutions">
        <outline text="Cottage industry (putting-out system) [5.3]"/>
        <outline text="Factory system [5.3]"/>
        <outline text="Enclosure of the commons [5.3]"/>
        <outline text="Protection of private property [5.3]"/>
        <outline text="Coaling stations (Cape Colony) [5.5]"/>
        <outline text="Corporations and limited liability [5.7]"/>
        <outline text="Unilever (Lever Brothers) [5.7]"/>
        <outline text="Lloyd's of London (marine insurance) [5.7]"/>
        <outline text="Labor unions (organized in secret) [5.8]"/>
        <outline text="Tenements and slums [5.9]"/>
        <outline text="Fabian Society [5.1]"/>
        <outline text="Classical liberalism [5.1]"/>
      </outline>
    </outline>
    <outline text="France">
      <outline text="People">
        <outline text="René Descartes (1596–1650) — Reason over tradition [5.1]"/>
        <outline text="Montesquieu (1689–1755) — Separation of powers [5.1]"/>
        <outline text="Voltaire (1694–1778) — Candide; religious liberty and judicial reform [5.1]"/>
        <outline text="Jean-Jacques Rousseau (1712–1778) — Emile and The Social Contract; General Will [5.1]"/>
        <outline text="Olympe de Gouges (1748–1793) — Declaration of the Rights of Woman [5.1]"/>
        <outline text="Joseph de Maistre (1753–1821) — Conservative: every nation gets the government it deserves [5.2]"/>
        <outline text="Marquis de Lafayette (1757–1834) — Moderate seeking constitutional monarchy [5.2]"/>
        <outline text="Louis XVI (r. 1774–1792) — Rejected limited monarchy; executed [5.2]"/>
        <outline text="Henri de Saint-Simon (1760–1825) — Utopian socialist; proposed the Suez Canal [5.1]"/>
        <outline text="Charles Fourier (1772–1837) — Utopian socialist; 810 passions [5.1]"/>
        <outline text="Alfred Dreyfus (1859–1935) — Jewish officer falsely convicted of treason [5.1]"/>
        <outline text="Maximilien Robespierre (1758–1794) — Led the Reign of Terror [5.2 CED]"/>
        <outline text="Napoleon Bonaparte (1769–1821; emperor 1804–1814/15) — Became emperor 1804; spread nationalism by conquest [5.2]"/>
      </outline>
      <outline text="Events">
        <outline text="1748 — The Spirit of the Laws [5.1]"/>
        <outline text="1762 — The Social Contract and Emile [5.1]"/>
        <outline text="1789 — Estates-General, Bastille, Rights of Man; feudal rights abolished [5.1, 5.2]"/>
        <outline text="1791 — Declaration of the Rights of Woman [5.1]"/>
        <outline text="1792 — First French Republic [5.2]"/>
        <outline text="1793–1794 — Reign of Terror [5.2]"/>
        <outline text="1799 — Napoleon takes power [5.2]"/>
        <outline text="1804 — Napoleon becomes emperor (Napoleonic Code: CED) [5.2]"/>
        <outline text="1848 — Paris protesters demand press freedom [5.10]"/>
        <outline text="1858 — Napoleon III drawn into war with Austria [5.2]"/>
        <outline text="1894 — Dreyfus Affair [5.1]"/>
      </outline>
      <outline text="Institutions">
        <outline text="Estates system [5.2]"/>
        <outline text="Estates-General [5.2]"/>
        <outline text="National Assembly [5.2]"/>
        <outline text="Jacobins [5.2]"/>
      </outline>
    </outline>
    <outline text="United States">
      <outline text="People">
        <outline text="Thomas Jefferson (1743–1826) — Wrote the Declaration; unalienable rights [5.2]"/>
        <outline text="Thomas Paine (1737–1809) — Common Sense; The Age of Reason [5.1]"/>
        <outline text='Mary Harris "Mother" Jones (1837–1930) — Labor organizer for coal miners [5.8]'/>
        <outline text="Lucretia Mott (1793–1880) — Organized Seneca Falls [5.1]"/>
        <outline text="Elizabeth Cady Stanton (1815–1902) — Declaration of Sentiments [5.1]"/>
        <outline text="Eli Whitney (1765–1825) — Interchangeable parts for firearms [5.3]"/>
        <outline text="Henry Ford (1863–1947) — Moving assembly line for the Model T [5.3]"/>
        <outline text="Samuel Slater (1768–1835) — Brought textile machines to the U.S. [5.4 CED]"/>
        <outline text="Samuel Morse (1791–1872) — Telegraph and Morse code [5.5 CED]"/>
        <outline text="Alexander Graham Bell (1847–1922) — Telephone [5.5]"/>
        <outline text="Thomas Edison (1847–1931) — Improved telephone transmitter (1886) [5.5]"/>
        <outline text="Andrew Carnegie (1835–1919) — Steel industrialist [5.7 CED]"/>
        <outline text="John D. Rockefeller (1839–1937) — Standard Oil monopoly [5.7]"/>
      </outline>
      <outline text="Events">
        <outline text="1775–1783 — American Revolution [5.2]"/>
        <outline text="1776 — Declaration of Independence [5.1 CED, 5.2]"/>
        <outline text="1776 — Common Sense [5.1]"/>
        <outline text="1787 — U.S. Constitution [5.1 CED, 5.2 CED]"/>
        <outline text="1793 — Cotton gin [5.3 CED]"/>
        <outline text="1794 — The Age of Reason [5.1]"/>
        <outline text="1798 — Whitney's interchangeable parts [5.3]"/>
        <outline text="1808 — Slave trade banned [5.1]"/>
        <outline text="1844 — First major telegraph line [5.5 CED]"/>
        <outline text="1848 — Seneca Falls Convention (about 300 people); Declaration of Sentiments [5.1, 5.9]"/>
        <outline text="1861–1865 — Civil War; slavery abolished 1865 [5.1 CED, 5.10 CED]"/>
        <outline text="1869 — Transcontinental Railroad completed [5.5]"/>
        <outline text="1876 — Bell's telephone patent [5.5]"/>
        <outline text="1879 — Light bulb [5.5 CED]"/>
        <outline text="1886 — Edison's improved telephone transmitter [5.5]"/>
        <outline text="c. 1900 — Leading industrial force, built by immigrant labor [5.4]"/>
      </outline>
      <outline text="Institutions">
        <outline text="Colonial legislatures [5.2]"/>
        <outline text="Lowell mills [5.4 CED]"/>
