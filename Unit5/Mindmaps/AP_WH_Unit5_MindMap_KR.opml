<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>Unit 5: 혁명의 시대 (Revolutions, c. 1750–c. 1900)</title>
  </head>
  <body>
  <outline text="Unit 5: 혁명의 시대 (Revolutions, c. 1750–c. 1900)">
    <outline text="영국 (Britain)">
      <outline text="인물">
        <outline text="에드먼드 버크 (Edmund Burke) (1729–1797) — 혁명을 비판한 보수주의자 [5.2]"/>
        <outline text="프랜시스 베이컨 (Francis Bacon) (1561–1626) — 경험주의 [5.1]"/>
        <outline text="토머스 홉스 (Thomas Hobbes) (1588–1679) — 『리바이어던』, 사회 계약에 따른 강력한 통치자 [5.1]"/>
        <outline text="존 로크 (John Locke) (1632–1704) — 자연권, 저항권, 백지 상태 [5.1]"/>
        <outline text="애덤 스미스 (Adam Smith) (1723–1790) — 『국부론』, 자유방임 [5.1, 5.7]"/>
        <outline text="메리 울스턴크래프트 (Mary Wollstonecraft) (1759–1797) — 『여성의 권리 옹호』 [5.1]"/>
        <outline text="제임스 하그리브스 (James Hargreaves) (c. 1720–1778) — 제니 방적기 [5.3]"/>
        <outline text="리처드 아크라이트 (Richard Arkwright) (1732–1792) — 수력 방적기, 공장제의 아버지 [5.3]"/>
        <outline text="제임스 와트 (James Watt) (1736–1819) — 석탄 동력을 활용한 증기 기관 [5.5]"/>
        <outline text="헨리 코트 (Henry Cort) (1740–1800) — 연철 제조법 [5.5]"/>
        <outline text="조지 스티븐슨 (George Stephenson) (1781–1848) — 증기 기관차 로켓호 [5.5 CED]"/>
        <outline text="헨리 베서머 (Henry Bessemer) (1813–1898) — 강철 대량 생산을 위한 베서머 공법 [5.5]"/>
        <outline text="로버트 오언 (Robert Owen) (1771–1858) — 유토피아 사회주의자, 뉴래너크와 뉴하모니 [5.1, 5.8]"/>
        <outline text="존 스튜어트 밀 (John Stuart Mill) (1806–1873) — 공리주의, 노동조합 합법화, 아동 노동 제한, 안전한 공장 [5.8]"/>
        <outline text="세실 로즈 (Cecil Rhodes) (1853–1902) — 드비어스 설립, 케이프-카이로 철도 계획 [5.7]"/>
        <outline text="찰스 디킨스 (Charles Dickens) (1812–1870) — 『올리버 트위스트』(1839): 중산층 대 도시 빈민 [5.9]"/>
      </outline>
      <outline text="사건">
        <outline text="1574 — 엘리자베스 1세의 농노제 조치 [5.1]"/>
        <outline text="early 1700s — 농업 혁명: 윤작, 파종기 [5.3]"/>
        <outline text="c. 1750 — 산업 혁명 시작 [5.3]"/>
        <outline text="1760s — 제니 방적기 [5.3]"/>
        <outline text="1765 — 와트의 증기 기관 [5.5]"/>
        <outline text="1769 — 아크라이트, 수력 방적기 특허 [5.3]"/>
        <outline text="1794 — 코트, 연철 제조법 특허 [5.5]"/>
        <outline text="1807 — 노예 무역 금지 [5.1]"/>
        <outline text="1811–1816 — 러다이트 기계 파괴 운동 [5.8 CED]"/>
        <outline text="1827 — 영국·프랑스·러시아 함대, 오스만 함대 격파 [5.2]"/>
        <outline text="1830 — 리버풀–맨체스터 철도 개통 [5.5 CED]"/>
        <outline text="1832, 1867, 1884 — 선거법 개정으로 남성 선거권 확대 [5.1, 5.8]"/>
        <outline text="1833 — 새들러 보고서, 공장법, 제국 내 노예제 폐지 [5.1 CED, 5.8]"/>
        <outline text="1840 — 영국, 뉴질랜드 병합 [5.2]"/>
        <outline text="1840s — 여성의 탄광 노동 금지 [5.9]"/>
        <outline text="1843 — 10세 미만 아동의 탄광 노동 금지 [5.8]"/>
        <outline text="1846 — 곡물법 폐지 [5.7 CED]"/>
        <outline text="1847 — 10시간 노동법 [5.8 CED]"/>
        <outline text="second half of 1800s — 공중 보건법, 뮤직홀, 공원 [5.7, 5.9]"/>
        <outline text="1856 — 베서머 공법 [5.5]"/>
        <outline text="1881 — 5–10세 의무 교육 [5.8]"/>
        <outline text="1882 — 런던에 최초의 공공 발전소 개소 [5.5]"/>
        <outline text="1882 — 영국, 이집트 점령 [5.6 CED]"/>
        <outline text="1918 — 모든 남성의 투표권 [5.8]"/>
        <outline text="1928 — 여성의 동등한 투표권 획득 [5.1, 5.8]"/>
      </outline>
      <outline text="제도">
        <outline text="가내 공업 (선대제) [5.3]"/>
        <outline text="공장제 [5.3]"/>
        <outline text="공유지 인클로저 [5.3]"/>
        <outline text="사유 재산 보호 [5.3]"/>
        <outline text="석탄 보급소 (케이프 식민지) [5.5]"/>
        <outline text="기업과 유한 책임 [5.7]"/>
        <outline text="유니레버 (레버 브라더스) [5.7]"/>
        <outline text="런던의 로이즈 (해상 보험) [5.7]"/>
        <outline text="노동조합 (비밀 조직) [5.8]"/>
        <outline text="공동 주택과 빈민가 [5.9]"/>
        <outline text="페이비언 협회 [5.1]"/>
        <outline text="고전적 자유주의 [5.1]"/>
      </outline>
    </outline>
    <outline text="프랑스 (France)">
      <outline text="인물">
        <outline text="르네 데카르트 (René Descartes) (1596–1650) — 전통보다 이성 [5.1]"/>
        <outline text="몽테스키외 (Montesquieu) (1689–1755) — 삼권 분립 [5.1]"/>
        <outline text="볼테르 (Voltaire) (1694–1778) — 『캉디드』, 종교 자유와 사법 개혁 [5.1]"/>
        <outline text="장자크 루소 (Jean-Jacques Rousseau) (1712–1778) — 『에밀』과 『사회 계약론』, 일반 의지 [5.1]"/>
        <outline text="올랭프 드 구주 (Olympe de Gouges) (1748–1793) — 『여성과 여성 시민의 권리 선언』 [5.1]"/>
        <outline text="조제프 드 메스트르 (Joseph de Maistre) (1753–1821) — 보수주의자: 모든 국민은 자신에게 맞는 정부를 갖는다 [5.2]"/>
        <outline text="라파예트 후작 (Marquis de Lafayette) (1757–1834) — 입헌 군주제를 추구한 온건파 [5.2]"/>
        <outline text="루이 16세 (Louis XVI) (r. 1774–1792) — 제한 군주제 거부, 처형됨 [5.2]"/>
        <outline text="앙리 드 생시몽 (Henri de Saint-Simon) (1760–1825) — 유토피아 사회주의자, 수에즈 운하 제안 [5.1]"/>
        <outline text="샤를 푸리에 (Charles Fourier) (1772–1837) — 유토피아 사회주의자, 810가지 정념 [5.1]"/>
        <outline text="알프레드 드레퓌스 (Alfred Dreyfus) (1859–1935) — 반역죄 누명을 쓴 유대인 장교 [5.1]"/>
        <outline text="막시밀리앙 로베스피에르 (Maximilien Robespierre) (1758–1794) — 공포 정치 주도 [5.2 CED]"/>
        <outline text="나폴레옹 보나파르트 (Napoleon Bonaparte) (1769–1821; emperor 1804–1814/15) — 1804년 황제 즉위, 정복으로 민족주의 확산 [5.2]"/>
      </outline>
      <outline text="사건">
        <outline text="1748 — 『법의 정신』 출간 [5.1]"/>
        <outline text="1762 — 『사회 계약론』과 『에밀』 출간 [5.1]"/>
        <outline text="1789 — 삼부회, 바스티유 습격, 인권 선언, 봉건적 권리 폐지 [5.1, 5.2]"/>
        <outline text="1791 — 여성 권리 선언 [5.1]"/>
        <outline text="1792 — 제1공화국 수립 [5.2]"/>
        <outline text="1793–1794 — 공포 정치 [5.2]"/>
        <outline text="1799 — 나폴레옹 집권 [5.2]"/>
        <outline text="1804 — 나폴레옹 황제 즉위 (나폴레옹 법전: CED) [5.2]"/>
        <outline text="1848 — 파리 시위대의 언론 자유 요구 [5.10]"/>
        <outline text="1858 — 나폴레옹 3세, 오스트리아와의 전쟁에 개입 [5.2]"/>
        <outline text="1894 — 드레퓌스 사건 [5.1]"/>
      </outline>
      <outline text="제도">
        <outline text="신분제 (Estates) [5.2]"/>
        <outline text="삼부회 [5.2]"/>
        <outline text="국민 의회 [5.2]"/>
        <outline text="자코뱅 [5.2]"/>
      </outline>
    </outline>
    <outline text="미국 (United States)">
      <outline text="인물">
        <outline text="토머스 제퍼슨 (Thomas Jefferson) (1743–1826) — 독립 선언문 작성, 양도할 수 없는 권리 [5.2]"/>
        <outline text="토머스 페인 (Thomas Paine) (1737–1809) — 『상식』, 『이성의 시대』 [5.1]"/>
        <outline text="메리 해리스 '마더' 존스 (Mary Harris &quot;Mother&quot; Jones) (1837–1930) — 광부들을 위한 노동 운동가 [5.8]"/>
        <outline text="루크리셔 모트 (Lucretia Mott) (1793–1880) — 세네카 폴스 대회 조직 [5.1]"/>
        <outline text="엘리자베스 케이디 스탠턴 (Elizabeth Cady Stanton) (1815–1902) — 『감정 선언문』 [5.1]"/>
        <outline text="엘리 휘트니 (Eli Whitney) (1765–1825) — 총기 호환 부품 [5.3]"/>
        <outline text="헨리 포드 (Henry Ford) (1863–1947) — 모델 T를 위한 이동식 조립 라인 [5.3]"/>
        <outline text="새뮤얼 슬레이터 (Samuel Slater) (1768–1835) — 섬유 기계를 미국에 도입 [5.4 CED]"/>
        <outline text="새뮤얼 모스 (Samuel Morse) (1791–1872) — 전신과 모스 부호 [5.5 CED]"/>
        <outline text="알렉산더 그레이엄 벨 (Alexander Graham Bell) (1847–1922) — 전화 [5.5]"/>
        <outline text="토머스 에디슨 (Thomas Edison) (1847–1931) — 개량 전화 송화기 (1886) [5.5]"/>
        <outline text="앤드루 카네기 (Andrew Carnegie) (1835–1919) — 철강 기업가 [5.7 CED]"/>
        <outline text="존 D. 록펠러 (John D. Rockefeller) (1839–1937) — 스탠더드 오일 독점 [5.7]"/>
      </outline>
      <outline text="사건">
        <outline text="1775–1783 — 미국 혁명 [5.2]"/>
        <outline text="1776 — 독립 선언 [5.1 CED, 5.2]"/>
        <outline text="1776 — 『상식』 출간 [5.1]"/>
        <outline text="1787 — 미국 헌법 [5.1 CED, 5.2 CED]"/>
        <outline text="1793 — 조면기 발명 [5.3 CED]"/>
        <outline text="1794 — 『이성의 시대』 출간 [5.1]"/>
        <outline text="1798 — 휘트니의 호환 부품 [5.3]"/>
        <outline text="1808 — 노예 무역 금지 [5.1]"/>
        <outline text="1844 — 첫 주요 전신선 [5.5 CED]"/>
        <outline text="1848 — 세네카 폴스 대회 (약 300명), 『감정 선언문』 [5.1, 5.9]"/>
        <outline text="1861–1865 — 남북 전쟁, 1865년 노예제 폐지 [5.1 CED, 5.10 CED]"/>
        <outline text="1869 — 대륙 횡단 철도 완공 [5.5]"/>
        <outline text="1876 — 벨의 전화 특허 [5.5]"/>
        <outline text="1879 — 전구 발명 [5.5 CED]"/>
        <outline text="1886 — 에디슨의 개량 전화 송화기 [5.5]"/>
        <outline text="c. 1900 — 이민 노동력으로 성장한 공업 강국 [5.4]"/>
      </outline>
      <outline text="제도">
        <outline text="식민지 의회 [5.2]"/>
        <outline text="로웰 공장 [5.4 CED]"/>
        <outline text="공공 보조를 받은 철도와 운하 [5.5]"/>
        <outline text="뉴하모니 공동체 [5.1]"/>
        <outline text="스탠더드 오일 독점 [5.7]"/>
      </outline>
    </outline>
    <outline text="아이티 (Haiti)">
      <outline text="인물">
        <outline text="투생 루베르튀르 (Toussaint L'Ouverture) (1743–1803) — 아이티 혁명 지도, 1801년 헌법 [5.2]"/>
        <outline text="장자크 데살린 (Jean-Jacques Dessalines) (1758–1806) — 1804년 독립 선언 [5.2]"/>
      </outline>
      <outline text="사건">
        <outline text="1791 — 노예 봉기 시작 [5.2]"/>
        <outline text="1801 — 투생의 헌법 공포와 토지 개혁 [5.2]"/>
        <outline text="1803 — 투생, 프랑스 감옥에서 사망 [5.2]"/>
        <outline text="1804 — 독립: 서반구 최초의 흑인 주도 국가 [5.2]"/>
      </outline>
      <outline text="제도">
        <outline text="플랜테이션 노예제 (타도) [5.2]"/>
        <outline text="마룬 [5.2]"/>
      </outline>
    </outline>
    <outline text="라틴아메리카 (Latin America)">
      <outline text="인물">
        <outline text="시몬 볼리바르 (Simón Bolívar) (1783–1830) — 베네수엘라·콜롬비아·에콰도르·페루 해방, 그란 콜롬비아, 자메이카 편지 [5.1, 5.2]"/>
        <outline text="마누엘라 사엔스 (Manuela Sáenz) (1797–1856) — 대령, '해방자의 해방자' [5.2]"/>
        <outline text="롤라 로드리게스 데 티오 (Lola Rodríguez de Tió) (1843–1924) — 푸에르토리코 시인, 「라 보린케냐」 작사 [5.2]"/>
        <outline text="호세 데 산마르틴 (José de San Martín) (1778–1850) — 아르헨티나·칠레 해방 [5.2 CED]"/>
        <outline text="미겔 이달고 (Miguel Hidalgo) (1753–1811) — 멕시코 독립 봉기 시작 [5.2 CED]"/>
        <outline text="페드루 1세 (Pedro I) (1798–1834; emperor 1822–1831) — 브라질 독립 선언 [5.2 CED]"/>
      </outline>
      <outline text="사건">
        <outline text="1808 — 나폴레옹의 스페인 침공 [5.2]"/>
        <outline text="1810 — 멕시코 이달고의 봉기 [5.2 CED]"/>
        <outline text="1815 — 자메이카 편지 [5.1, 5.2]"/>
        <outline text="1821 — 멕시코 독립 [5.2 CED]"/>
        <outline text="1822 — 사엔스의 키토 전투 참전 (브라질 독립: CED) [5.2]"/>
        <outline text="1853 — 아르헨티나 헌법, 이민 장려 [5.2]"/>
        <outline text="1860 — 페루, 스페인어 문해 투표 조건 폐지 [5.2]"/>
        <outline text="1868 — 푸에르토리코와 쿠바의 봉기 [5.2]"/>
        <outline text="1888 — 브라질 노예제 폐지 [5.1, 5.10 CED]"/>
      </outline>
      <outline text="제도">
        <outline text="페닌술라레스·크리오요·메스티소·물라토 위계 [5.2]"/>
        <outline text="그란 콜롬비아 [5.2]"/>
        <outline text="카우디요 [5.2]"/>
        <outline text="스페인 중상주의 [5.2]"/>
      </outline>
    </outline>
    <outline text="이탈리아와 독일 (Italy and German States)">
      <outline text="인물">
        <outline text="주세페 마치니 (Giuseppe Mazzini) (1805–1872) — 리소르지멘토 [5.2]"/>
        <outline text="카밀로 디 카보우르 (Camillo di Cavour) (1810–1861) — 피에몬테-사르데냐 총리, 현실 정치 [5.2]"/>
        <outline text="주세페 가리발디 (Giuseppe Garibaldi) (1807–1882) — 남부 이탈리아의 붉은 셔츠단 [5.2]"/>
        <outline text="오토 폰 비스마르크 (Otto von Bismarck) (1815–1898) — 독일 통일, 산재·실업·노령 보험 [5.2, 5.10]"/>
        <outline text="알프레트 크루프 (Alfred Krupp) (1812–1887) — 베서머 공법으로 독일 철강 독점 [5.7]"/>
        <outline text="카를 마르크스 (Karl Marx) (1818–1883) — 『공산당 선언』, 과학적 사회주의 [5.8, 5.10]"/>
        <outline text="프리드리히 엥겔스 (Friedrich Engels) (1820–1895) — 『공산당 선언』 공저자이자 후원자 [5.8, 5.10]"/>
        <outline text="카를 벤츠 (Karl Benz) (1844–1929) — 휘발유 자동차 [5.5 CED]"/>
        <outline text="굴리엘모 마르코니 (Guglielmo Marconi) (1874–1937) — 대서양 횡단 무선 신호 (1901) [5.5]"/>
