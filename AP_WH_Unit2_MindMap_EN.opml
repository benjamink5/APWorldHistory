<?xml version='1.0' encoding='UTF-8'?>
<opml version="2.0">
  <head>
    <title>AP World History: Modern — Unit 2 Networks of Exchange (c. 1200–1450): People, Events &amp; Institutions by Region</title>
    <dateCreated>Sun, 15 Nov 2026 21:42:26 -0800</dateCreated>
  </head>
  <body>
    <outline text="Unit 2: Networks of Exchange (c. 1200–1450)">
      <outline text="Legend: [2.x] = source topic · ⚠️ = textbook differs from most sources · Events in chronological order" />
      <outline text="Mongol Empire">
        <outline text="People">
          <outline text="Genghis Khan (b. 1162; r. 1206–1227) — united the steppe clans and founded the Mongol Empire [2.2]" />
          <outline text="Ögödei Khan (r. 1229–1241) — his death made Batu call off the invasion of Western Europe [2.2]" />
        </outline>
        <outline text="Events">
          <outline text="1162 — Temujin is born [2.2]" />
          <outline text="1204 — A captured scribe adapts the Uyghur alphabet to write Mongolian [2.2]" />
          <outline text="1206 — A kuriltai elects Temujin khan; he takes the name Genghis Khan [2.2]" />
          <outline text="1210 — Genghis Khan attacks the Jin Empire in northern China [2.2]" />
          <outline text="1219 — Conquest of the Kara Khitai and Khwarazm empires [2.2]" />
          <outline text="1227 — The khanate reaches from the North China Sea to eastern Persia [2.2]" />
          <outline text="c. 1250–1350 — Pax Mongolica revives Silk Roads trade (third golden age) [2.1, 2.2]" />
        </outline>
        <outline text="Institutions">
          <outline text="Kuriltai — meeting of Mongol chieftains that elected the khan [2.2]" />
          <outline text="Khanates — kingdoms of Genghis Khan's grandsons (Golden Horde, Il-khanate, Yuan) [2.2]" />
          <outline text="Military system — short-bow horse archers, feigned retreats, mapping units &amp; captured engineers' siege weapons [2.2]" />
          <outline text="Messenger relay (“pony express”) carrying oral messages [2.2]" />
          <outline text="Religious tolerance across the empire [2.2]" />
          <outline text="Capital at Karakorum; large-scale road &amp; bridge building [2.2]" />
          <outline text="Centralized power &amp; a single international law, later copied by other states [2.2]" />
          <outline text="Greater freedom for Mongol women (riding, divorce, remarriage, advisors to the khan) [2.2, 2.7]" />
        </outline>
      </outline>
      <outline text="China (Song, Yuan, Ming)">
        <outline text="People">
          <outline text="Xuanzang (602–664) — monk who helped make Buddhism popular in China [2.5]" />
          <outline text="Lu You (1125–1210) — poet of Hangzhou (textbook spelling “Lu Yu”) [2.5]" />
          <outline text="Xin Qiji (1140–1207) — poet of Hangzhou [2.5]" />
          <outline text="Kublai Khan (r. 1260–1294) — Great Khan who founded the Yuan Dynasty &amp; rebuilt Zhongdu as Dadu [2.2]" />
          <outline text="Zhu Yuanzhang (r. 1368–1398) — Buddhist monk of peasant birth who overthrew the Yuan &amp; founded the Ming [2.2]" />
          <outline text="Zheng He (1371–1433) — Muslim admiral who led seven voyages across the Indian Ocean [2.3]" />
          <outline text="Yongle Emperor (r. 1402–1424) — Ming emperor who sent Zheng He on his first voyage [2.3]" />
          <outline text="Zhu Gaozhi (r. 1424–1425) — ended the voyages &amp; banned ships with more than two masts [2.3]" />
        </outline>
        <outline text="Events">
          <outline text="c. 800 — Paper money appears in China [2.1]" />
          <outline text="960–1279 — Song Dynasty: Neo-Confucianism develops; printing spreads Buddhist scriptures [2.5]" />
          <outline text="1215 — Mongols destroy Zhongdu (Beijing) [2.2]" />
          <outline text="1260 — Kublai becomes Great Khan [2.2]" />
          <outline text="1271 — Kublai founds the Yuan Dynasty after defeating the Song (⚠️ textbook; the Southern Song fell in 1279) [2.2]" />
          <outline text="1274 — Yuan's failed expansion begins (Japan, Indochina, Burma, Java) [2.2]" />
          <outline text="1332–1347 — About 25 million die of plague in China &amp; other parts of Asia [2.6]" />
          <outline text="1350s — Secret White Lotus Society organizes against the Yuan [2.2]" />
          <outline text="1368 — Zhu Yuanzhang founds the Ming Dynasty (1368–1644) [2.2]" />
          <outline text="1405 — First of Zheng He's seven voyages [2.3]" />
          <outline text="1433 — Zheng He dies; the voyages end [2.3]" />
        </outline>
        <outline text="Institutions">
          <outline text="Money economy, flying cash &amp; paper money [2.1]" />
          <outline text="Junk, magnetic compass &amp; stern rudder [2.1, 2.3]" />
          <outline text="Tribute system [2.3]" />
          <outline text="Proto-industrialization of iron, steel &amp; porcelain [2.1, 2.7]" />
          <outline text="Champa rice on upland terraces &amp; lowland paddies [2.6]" />
          <outline text="Chan (Zen) Buddhism &amp; Neo-Confucianism [2.5]" />
          <outline text="Yuan rule: foreigners in government, civil service exams dismantled, Mongols kept separate [2.2]" />
          <outline text="Hangzhou — trade &amp; culture center at the southern end of the Grand Canal (about 1 million people) [2.5]" />
        </outline>
      </outline>
      <outline text="Korea &amp; Japan">
        <outline text="Events">
          <outline text="1274 — Yuan invasion of Japan fails (start of the Yuan's failed expansion) [2.2]" />
        </outline>
        <outline text="Institutions">
          <outline text="Korea: Confucian classics for the elite, Buddhism for peasants [2.5]" />
          <outline text="Neo-Confucianism becomes Korea's official state ideology [2.5]" />
          <outline text="Japan adopts Buddhism (Zen) &amp; Neo-Confucianism [2.5]" />
        </outline>
      </outline>
      <outline text="Central Asia">
        <outline text="People">
          <outline text="Tamerlane (Timur) (r. 1370–1405) — conquered Central Asia &amp; ravaged Kashgar [2.2, 2.5]" />
        </outline>
        <outline text="Events">
          <outline text="c. 1369 — Tamerlane conquers the Central Asian territories (textbook) [2.2]" />
          <outline text="1389–1390 — Tamerlane ravages Kashgar [2.5]" />
        </outline>
        <outline text="Institutions">
          <outline text="Caravans &amp; camel saddles [2.1]" />
          <outline text="Caravanserai — inns about 100 miles apart [2.1]" />
          <outline text="Kashgar — oasis city where routes crossed; Buddhist, then a center of Islamic scholarship [2.1, 2.5]" />
          <outline text="Samarkand — Zeravshan valley trade city of Christians, Buddhists, Zoroastrians &amp; Muslims [2.1, 2.5]" />
          <outline text="Sogdian merchants — main caravan merchants of the Silk Roads [2.3]" />
          <outline text="Samarkand's markets pass fruit, rice &amp; citrus on to Europe [2.6]" />
        </outline>
      </outline>
      <outline text="Southwest Asia (Abbasids, Il-khanate, Mamluks)">
        <outline text="People">
          <outline text="Hulegu (r. 1256–1265) — destroyed Baghdad &amp; founded the Il-khanate [2.2]" />
          <outline text="Baibars (r. 1260–1277) — Mamluk leader who defeated the Mongols in 1260 [2.2]" />
        </outline>
        <outline text="Events">
          <outline text="8th–9th centuries — Abbasid Arab merchants revive the Silk Roads &amp; Indian Ocean routes [2.1]" />
          <outline text="1258 — Mongols destroy Baghdad, killing the caliph &amp; perhaps 200,000 residents [2.1, 2.2]" />
          <outline text="1260 — Mamluk &amp; Crusader alliance defeats the Mongols in Palestine (⚠️ textbook; often described as the Crusaders only allowing passage) [2.2]" />
        </outline>
        <outline text="Institutions">
          <outline text="Il-khanate: Mongol rulers with Persian ministers &amp; officials for maximum tax collection [2.2]" />
          <outline text="Conversion to Islam, then massacres of Jews &amp; Christians (⚠️ textbook names Hulegu; most sources say Ghazan, 1295) [2.2]" />
          <outline text="Dar al-Islam — the Muslim world linking North Africa to South Asia [2.3]" />
          <outline text="Islamic scholarship — Greek classics into Arabic, Indian math, hospitals &amp; surgery [2.5]" />
          <outline text="Caliphs spread cotton, sugar &amp; citrus with Islam &amp; Arabic [2.6]" />
        </outline>
      </outline>
      <outline text="Russia (Kievan Rus &amp; the Golden Horde)">
        <outline text="People">
          <outline text="Vladimir I (r. 980–1015) — converted Kievan Rus to Christianity [2.4]" />
          <outline text="Yaroslav I (r. 1019–1054) — codified the legal system [2.4]" />
          <outline text="Batu (r. 1227–1255) — led the Golden Horde into Russia &amp; Eastern Europe [2.2]" />
        </outline>
        <outline text="Events">
          <outline text="989 — Vladimir I converts to Christianity [2.4]" />
          <outline text="1236 — Batu invades Russia with 100,000 soldiers [2.2]" />
          <outline text="1240 — Kiev is looted &amp; destroyed [2.2]" />
          <outline text="1241 — Batu defeats Polish, German &amp; French knights, then Hungarian knights [2.2]" />
          <outline text="c. 1369 — Golden Horde loses its territory (⚠️ textbook; Mongol tribute is often dated to 1480) [2.2]" />
          <outline text="1380 — Moscow-led coalition defeats the Golden Horde at Kulikovo [2.2]" />
          <outline text="Mid-1500s — Russia defeats all descendant khans except the Crimean Tatars [2.2]" />
          <outline text="Late 1700s — The Crimean Tatars are defeated [2.2]" />
        </outline>
        <outline text="Institutions">
          <outline text="Kievan Rus (peak 900s–1200s) — first large civilization in Russia; spread Christianity eastward [2.4]" />
          <outline text="Indirect rule — Russian princes paid tribute to the Mongols [2.2]" />
          <outline text="Moscow's extra tribute &amp; anti-Mongol coalition [2.2]" />
          <outline text="Centralized leadership &amp; a distinctly Russian culture, cut off from Western Europe [2.2]" />
        </outline>
      </outline>
      <outline text="Byzantine Empire">
        <outline text="People">
          <outline text="Justinian (r. 527–565) — ruler behind the Body of Civil Law [2.4]" />
          <outline text="Heraclius (r. 610–641) — shifted the empire's focus to the East [2.4]" />
        </outline>
        <outline text="Events">
          <outline text="330 — Byzantine peak years begin (capital Constantinople) [2.4]" />
          <outline text="1204 — Fourth Crusade armies attack &amp; weaken Constantinople [2.5]" />
          <outline text="1346, 1349 — Plague kills about half of Constantinople [2.5]" />
          <outline text="1453 — Constantinople falls to the Ottomans after a 53-day siege [2.5]" />
        </outline>
        <outline text="Institutions">
          <outline text="Carried on the Roman legacy; fostered trade among Asia, Europe &amp; Africa [2.4]" />
          <outline text="Ottoman Turks take Byzantine lands, but the trade routes stay open [2.1]" />
        </outline>
      </outline>
      <outline text="Western Europe">
        <outline text="People">
          <outline text="Matthew Paris (c. 1200–1259) — English monk who wrote of Mongol atrocities without firsthand knowledge [2.2]" />
          <outline text="Henry of Silesia (d. 1241) — led the European knights Batu defeated in 1241 [2.2]" />
          <outline text="Marco Polo (1254–1324; ⚠️ textbook 1245) — Venetian merchant at Kublai Khan's court [2.1, 2.5]" />
          <outline text="Francesco Balducci Pegolotti (fl. c. 1310–1347; ⚠️ textbook 1471) — Italian merchant who advised gifts to customs officers [2.1]" />
          <outline text="Giovanni Boccaccio (1313–1375) — wrote The Decameron after living through the plague [2.6]" />
          <outline text="Margery Kempe (c. 1373–c. 1440) — English mystic who dictated one of the earliest English autobiographies [2.5]" />
        </outline>
        <outline text="Events">
          <outline text="13th century — Papermaking reaches Europe from China [2.5]" />
          <outline text="1295 — Marco Polo returns to Italy &amp; writes his book [2.5]" />
          <outline text="1296 — Hanseatic League (textbook table date) [2.1]" />
          <outline text="c. 1300 — Little Ice Age begins (to c. 1800) [2.6]" />
          <outline text="1300s — Banking houses appear in European cities [2.1]" />
          <outline text="1347 — Plague reaches Europe [2.6]" />
          <outline text="1347–1351 — Black Death peaks; about one-third of Europe (up to 25 million) dies [2.5, 2.6]" />
          <outline text="c. 1413 — Margery Kempe's pilgrimages begin [2.5]" />
          <outline text="Mid-1600s — Hanseatic League ends [2.1]" />
        </outline>
        <outline text="Institutions">
          <outline text="Crusades — spurred demand for Asian goods &amp; knowledge of the Byzantine &amp; Islamic worlds [2.1, 2.5]" />
          <outline text="Hanseatic League — Lübeck, Hamburg &amp; Riga monopolized Baltic &amp; North Sea trade [2.1]" />
          <outline text="Banking houses &amp; bills of exchange [2.1]" />
          <outline text="Feudalism weakened by plague labor shortages &amp; higher wages [2.5, 2.6]" />
          <outline text="Soil erosion from deforestation &amp; overused farmland [2.6]" />
          <outline text="Women worked as farmers &amp; artisans and had their own guilds [2.7]" />
        </outline>
      </outline>
      <outline text="Al-Andalus (Muslim Iberia)">
        <outline text="People">
          <outline text="Ibn Rushd (1126–1198) — Islamic legal scholar &amp; philosopher [2.4]" />
          <outline text="Maimonides (1138–1204) — Jewish scholar of ethics [2.4]" />
        </outline>
        <outline text="Events">
          <outline text="711 — Al-Andalus begins (peak 711–1492) [2.4]" />
          <outline text="1492 — Al-Andalus ends [2.4]" />
        </outline>
        <outline text="Institutions">
          <outline text="Vibrant, tolerant society centered on Córdoba [2.4]" />
          <outline text="Preserved classical Greek learning, which returned to Western Europe [2.4, 2.5]" />
        </outline>
      </outline>
      <outline text="North Africa &amp; the Sahara">
        <outline text="People">
          <outline text="Ibn Battuta (1304–1368/69; ⚠️ textbook 1304–1353) — Moroccan scholar who traveled for more than 30 years, mostly in Muslim lands [2.4, 2.5]" />
        </outline>
        <outline text="Events">
          <outline text="3rd century BCE — Camels appear in North Africa [2.4]" />
          <outline text="After 300 CE — Camels replace horses &amp; donkeys [2.4]" />
          <outline text="7th–8th centuries — Muslim merchants increase the volume of trans-Saharan trade [2.4]" />
          <outline text="1325 — Ibn Battuta sets out alone at age 21 [2.5]" />
        </outline>
        <outline text="Institutions">
          <outline text="Sahara — about 3.6 million sq mi; oases only about 800 sq mi [2.4]" />
          <outline text="Caravans of thousands of camels on 7 north–south &amp; 2 east–west routes [2.4]" />
          <outline text="Arab &amp; Berber traders send salt, cloth, paper &amp; horses south [2.4]" />
          <outline text="Trade cities: Marrakesh &amp; Cairo [2.7]" />
        </outline>
      </outline>
      <outline text="West Africa (Ghana, Mali, Songhai)">
        <outline text="People">
          <outline text="Sundiata (r. c. 1235–c. 1255) — “Lion Prince” who founded Mali &amp; built its gold trade [2.4]" />
          <outline text="Mansa Musa (r. c. 1312–1337) — Sundiata's grand-nephew, famous for his 1324 hajj [2.4]" />
        </outline>
        <outline text="Events">
          <outline text="End of 8th century — Trans-Saharan trade is famous in Europe &amp; Asia [2.4]" />
          <outline text="9th century — North African traders bring Islam to the region (⚠️ before Mali existed) [2.4]" />
          <outline text="12th century — Wars permanently weaken Ghana [2.4]" />
          <outline text="1235 — Sundiata reclaims the throne &amp; founds Mali [2.4]" />
          <outline text="1324 — Mansa Musa's hajj with 100 camels, thousands of people &amp; gold [2.4]" />
          <outline text="Late 1400s — Songhai replaces Mali as the leading power [2.4]" />
          <outline text="1500s — Timbuktu's books sell for more than most goods [2.4]" />
        </outline>
        <outline text="Institutions">
          <outline text="Gold–salt trade (gold from the Senegal River) [2.4]" />
          <outline text="Taxes on nearly all trade entering West Africa [2.4]" />
          <outline text="Currencies: cowrie shells, cotton cloth, gold, glass beads &amp; salt [2.4, 2.7]" />
          <outline text="Armies with horses &amp; iron weapons bought with tax revenue [2.4]" />
          <outline text="Timbuktu &amp; Gao — centers of Muslim life; religious schools &amp; mosques [2.4]" />
          <outline text="Most people were farmers (sorghum, rice) who kept traditional beliefs [2.4]" />
        </outline>
      </outline>
      <outline text="East Africa (Swahili Coast &amp; Great Zimbabwe)">
        <outline text="Events">
          <outline text="c. 200 BCE — Indian Ocean trade already exists [2.3]" />
          <outline text="Late 1400s — Great Zimbabwe abandoned after overgrazing [2.6]" />
          <outline text="18th–19th centuries — Indian Ocean slave trade peaks [2.3]" />
        </outline>
        <outline text="Institutions">
          <outline text="Swahili city-states (Kilwa, Mombasa, Zanzibar) — “coasters” of the Zanj Coast [2.3]" />
          <outline text="Exports ivory, gold &amp; enslaved people; imports Chinese porcelain &amp; Indian cotton [2.3]" />
          <outline text="Stone &amp; coral mosques and merchants' homes in Kilwa [2.3]" />
          <outline text="Arab &amp; Persian diaspora; Islam spread through intermarriage [2.3]" />
          <outline text="Swahili language — a blend of Bantu &amp; Arabic [2.3, 2.5]" />
          <outline text="Somali camel saddle carrying up to 600 pounds [2.4]" />
          <outline text="Bananas from Indonesian seafarers enable Bantu migration [2.6]" />
          <outline text="Indian Ocean slave trade — ports, households, sailors &amp; soldiers [2.3]" />
        </outline>
      </outline>
      <outline text="South Asia">
        <outline text="People">
          <outline text="Abdu Razzak (1413–1482) — wrote “Description of Calicut” (1442) [2.7]" />
          <outline text="Domingo Paes (fl. 1520–1522; ⚠️ textbook “1300s”) — described 15,000–20,000 workers on a Vijayanagara reservoir [2.7]" />
        </outline>
        <outline text="Events">
          <outline text="1442 — Abdu Razzak describes Calicut's secure markets [2.7]" />
          <outline text="1520–1522 — Paes describes the Vijayanagara reservoir (after this unit's period) [2.7]" />
        </outline>
        <outline text="Institutions">
          <outline text="Calicut — “City of Spices,” where Arab &amp; Chinese merchants met [2.3, 2.7]" />
          <outline text="Gujarat — Rajput kingdom whose customs revenue exceeded the worth of some European states [2.3]" />
          <outline text="Specialized products: cotton, carpets, high-carbon steel &amp; pepper [2.3]" />
          <outline text="Sinhala dynasties (Sri Lanka) — Buddhist study; priests advised kings [2.5]" />
          <outline text="Conversions to Islam by Buddhists &amp; lower-caste Hindus [2.5]" />
          <outline text="Urdu language &amp; Bhakti poets [2.5]" />
          <outline text="Vijayanagara — large projects coordinated through kinship [2.7]" />
        </outline>
      </outline>
      <outline text="Southeast Asia">
        <outline text="Events">
          <outline text="1400s — Sultan of Malacca expands into Sumatra &amp; the southern Malay Peninsula [2.3]" />
          <outline text="1511 — Portugal invades Malacca [2.3]" />
        </outline>
        <outline text="Institutions">
          <outline text="Sultanate of Malacca — navy &amp; fees on ships in the Strait of Malacca [2.3, 2.7]" />
          <outline text="Srivijaya (Sumatra) — Hindu kingdom (⚠️ textbook; many sources say Buddhist) [2.5]" />
          <outline text="Majapahit (Java) — Buddhist kingdom (⚠️ textbook; many sources say Hindu) [2.5]" />
          <outline text="Khmer Empire — Angkor Thom with Hindu art, later Buddhist art added [2.5]" />
          <outline text="Spice Islands — nutmeg, cinnamon, cloves &amp; cardamom [2.3]" />
          <outline text="Champa — source of Champa rice sent to China as tribute [2.6]" />
          <outline text="Indonesian seafarers carry bananas to Africa &amp; settle Madagascar [2.6]" />
          <outline text="Tin ingots used as a currency standard [2.7]" />
          <outline text="Women ran markets for powerful families [2.7]" />
          <outline text="Javanese Muslim rulers blend traditions; puppetry &amp; poetry absorb Muslim themes [2.5]" />
          <outline text="Malay diaspora merchants (Sri Lanka) [2.3]" />
        </outline>
      </outline>
    </outline>
  </body>
</opml>